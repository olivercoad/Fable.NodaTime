<Project>
  <PropertyGroup>
    <Authors>Oliver Coad</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RepositoryUrl>https://github.com/olivercoad/Fable.NodaTime</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
    <!-- Fable.Temporal 0.1.0 requires this FSharp.Core version. -->
    <FSharpCoreImplicitPackageVersion>10.1.402</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
</Project>
